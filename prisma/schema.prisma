// Logistics OS — multi-tenant schema.
//
// Tenancy rules:
//  * Every operational model carries a required `companyId` and is only reachable through
//    the tenant-scoped client (src/lib/platform/db.ts), which injects `companyId` on every
//    read/write. Raw `prisma` is reserved for platform-level code (auth, webhooks, platform admin).
//  * `AuditLog` is append-only — enforced by a database trigger (see migration SQL).
//  * Money is Decimal(14,2) in the company currency. Subscription pricing is stored in kobo (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

