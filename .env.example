# ───────────────────────── Core (required) ─────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/logistics?schema=public"
# Generate a long random string (see WINDOWS_SETUP.md). Used to sign session cookies.
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────────────────────── Branding (optional; defaults live in src/config/brand.ts) ─────────────────────────
# NEXT_PUBLIC_APP_NAME="LogisticOS"
# NEXT_PUBLIC_APP_TAGLINE="The operating system for delivery & logistics"
# NEXT_PUBLIC_PRIMARY_COLOR="15 98 254"
# NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# NEXT_PUBLIC_WEBSITE_URL="https://example.com"

# ───────────────────────── Payments (subscriptions) ─────────────────────────
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Paystack signs webhooks with your secret key; set this only if you use a separate signing secret.
PAYSTACK_WEBHOOK_SECRET=""

# ───────────────────────── AI (use one or both; first configured wins unless AI_PROVIDER is set) ─────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# AI_PROVIDER="anthropic"   # or "openai"
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# OPENAI_MODEL="gpt-4o"

# ───────────────────────── Notifications ─────────────────────────
EMAIL_PROVIDER_KEY=""          # Resend API key
EMAIL_FROM="Logistics <noreply@example.com>"
SMS_PROVIDER_KEY=""            # Termii API key
SMS_SENDER_ID=""
WHATSAPP_PROVIDER_KEY=""       # Meta WhatsApp Cloud API access token
WHATSAPP_PHONE_NUMBER_ID=""

# ───────────────────────── Maps ─────────────────────────
MAPS_PROVIDER="osm"            # osm | mapbox | google (google = navigation links only)
MAPS_PROVIDER_KEY=""           # required for mapbox
# MAPS_TILE_URL="https://tiles.example.com/{z}/{x}/{y}.png?key={key}"  # use your own/commercial tiles in production

# ───────────────────────── Files ─────────────────────────
STORAGE_PROVIDER="disk"
STORAGE_DIR="./uploads"        # mount a persistent volume here in production

# ───────────────────────── Scheduled jobs ─────────────────────────
# POST /api/cron/maintenance with "Authorization: Bearer <CRON_SECRET>" (e.g. hourly). Disabled when unset.
CRON_SECRET=""

# ───────────────────────── Mobile (Capacitor shell) ─────────────────────────
# CAPACITOR_SERVER_URL="https://app.example.com/driver"

# ───────────────────────── Seeding / tests ─────────────────────────
# SEED_PASSWORD="choose-a-strong-demo-password"
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/logistics_test?schema=public"

# --- Optional: push notifications (FCM HTTP v1). Firebase service-account key as JSON or base64 ---
FCM_SERVICE_ACCOUNT_JSON=""

# --- Optional: S3-compatible storage (AWS S3, Cloudflare R2, MinIO). Set STORAGE_PROVIDER="s3" above ---
S3_BUCKET=""
S3_REGION=""                   # "auto" for Cloudflare R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""                 # blank = AWS; R2/MinIO: full https URL
S3_KEY_PREFIX=""

# --- Optional: key used to encrypt 2FA secrets at rest (defaults to NEXTAUTH_SECRET; changing it resets 2FA) ---
TWO_FACTOR_KEY=""
